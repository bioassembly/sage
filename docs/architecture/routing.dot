digraph "routing" {
  graph [rankdir=TB, bgcolor="white", pad="0.22", ranksep="0.40", nodesep="0.28", outputorder="edgesfirst"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, fontcolor="#173341", color="#52737d", fillcolor="#eff5f7", margin="0.17,0.12", penwidth=1.2];
  edge [fontname="Helvetica", fontsize=10, fontcolor="#315765", color="#63818b", arrowsize=0.7];
  start [label="1 · Start a native session", fillcolor="#d7eee6"];
  core [label="2a · Discover installed core skills"];
  manifest [label="2b · Read the catalog routing manifest"];
  codex [label="3a · Codex\nSessionStart and UserPromptSubmit"];
  open [label="3b · OpenCode\nWorkspace and prompt plugin events"];
  agy [label="3c · Antigravity\nSessionStart and PreInvocation"];
  match [label="4 · Match prompt prose and bounded workspace signals\nApply invocation policy and add companions"];
  none [label="5a · Continue the session\nNo new matching skill", fillcolor="#fcf1d9"];
  found [label="5b · Surface matching catalog skills"];
  use [label="6 · Read the applicable skill\nOpen supporting files as needed", fillcolor="#dcebf8"];
  { rank=same; core; manifest; }
  { rank=same; codex; open; agy; }
  { rank=same; none; found; }
  start -> core [label="core path"];
  start -> manifest [label="catalog path"];
  manifest -> codex [label="Codex"];
  manifest -> open [label="OpenCode"];
  manifest -> agy [label="Antigravity"];
  codex -> match;
  open -> match;
  agy -> match;
  match -> none [label="no new match"];
  match -> found [label="match"];
  found -> use [label="catalog skill"];
  core -> use [label="core skill"];
}
