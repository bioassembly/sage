      "\\bisolated branch\\b"
    ]
  },
  "variant-analysis": {
    "category": "security",
    "summary": "Find sibling bug variants across a codebase via patterns/CodeQL/Semgrep",
    "files": [
      "*.ql",
      ".semgrep.yml",
      ".semgrep.yaml"
    ],
    "patterns": [
      "\\bvariant analysis\\b",
      "\\bother instances\\b",
      "\\bsame bug\\b",
      "\\bcodeql\\b",
      "\\bsemgrep\\b"
    ]
  },
  "vercel-react-best-practices": {
    "category": "web",
    "summary": "React and Next.js performance, server/client boundaries and bundling",
    "files": [
      "next.config.*"
    ],
    "deps": [
      "react",
      "next"
    ],
    "patterns": [
      "\\breact\\b",
      "\\bnext\\.?js\\b",
      "\\bhydration\\b",
      "\\bserver component\\b",
      "\\buseeffect\\b"
    ]
  },
  "web-scraping": {
    "category": "web",
    "summary": "Extract structured data from web pages and APIs",
    "deps": [
      "beautifulsoup4",
      "scrapy",
      "cheerio",
      "puppeteer"
    ],
    "patterns": [
      "\\bscrap(e|ing)\\b",
      "\\bcrawl(ing|er)?\\b",
      "\\bextract (table|data) from (web|site|html)\\b"
    ]
  },
  "webapp-testing": {
    "category": "web",
    "summary": "Playwright browser verification, screenshots and local web UI debugging",
    "files": [
      "playwright.config.*",
      "cypress.config.*"
    ],
    "deps": [
      "playwright",
      "@playwright/test",
      "cypress"
    ],
    "patterns": [
