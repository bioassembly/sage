      "\\bbrowser test\\b",
      "\\bweb ?app\\b",
      "\\be2e\\b",
      "\\bscreenshot\\b"
    ]
  },
  "security-audit": {
    "category": "security",
    "summary": "OWASP Top-10 audit for auth, injection, XSS, CSRF, SSRF and secrets",
    "patterns": [
      "\\bsecurity (audit|review|scan)\\b",
      "\\bowasp\\b",
      "\\b(xss|csrf|ssrf|sql injection|idor)\\b",
      "\\bharden\\b"
    ]
  },
  "setup-matt-pocock-skills": {
    "category": "planning",
    "summary": "Initialize project workflow labels/conventions for spec-to-issue flow"
  },
