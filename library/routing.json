    "category": "meta",
    "summary": "Benchmark skills and prompts with A/B assertions",
    "dirs": [
      "evals"
    ],
    "patterns": [
      "\\bevaluate skill\\b",
      "\\ba/b compare\\b",
      "\\bskill[- ]evaluation\\b"
    ]
  },
  "skill-maker": {
    "category": "meta",
    "summary": "Author or refine skills with focused triggers and validation",
    "files": [
      "SKILL.md",
      "third_party/lock.json"
    ],
    "patterns": [
      "\\b(author|create|write|improve) a? ?skill\\b",
      "\\bskill[- ]maker\\b"
    ]
  },
  "statistical-data-visualization": {
    "category": "science",
    "summary": "Statistical plot correctness, bias checks and bioinformatics figures",
    "files": [
      "*.qmd",
      "*.Rmd",
      "_quarto.yml"
    ],
    "deps": [
      "matplotlib",
      "seaborn",
      "plotly",
      "ggplot2",
      "scipy",
      "statsmodels"
    ],
    "patterns": [
      "\\b(volcano|heatmap|boxplot|violin|scatter|pca|umap)\\b",
      "\\bvisuali[sz]ation\\b",
      "\\bquarto\\b",
      "\\bp[- ]?value\\b"
    ]
  },
  "to-spec": {
    "category": "planning",
    "summary": "Flesh out specifications/PRDs from rough feature ideas"
  },
  "to-tickets": {
    "category": "planning",
    "summary": "Break specs/PRDs into vertical-slice implementation issues"
  },
  "token-efficiency": {
    "category": "meta",
    "summary": "Diagnose context bloat and reduce harness token overhead",
