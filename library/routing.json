{
  "biopython": {
    "category": "bioinformatics",
    "summary": "FASTA/GenBank/PDB parsing, phylogenetics, BLAST and NCBI Entrez",
    "files": [
      "*.fasta",
      "*.fa",
      "*.fna",
      "*.faa",
      "*.gb",
      "*.gbk",
      "*.pdb"
    ],
    "deps": [
      "biopython"
    ],
    "patterns": [
      "\\bbiopython\\b",
      "\\bbio\\.entrez\\b",
      "\\b(fasta|genbank|pdb|blast|phylogenet|motif)\\b"
    ]
  },
  "codebase-design": {
    "category": "architecture",
    "summary": "Deep modules, interface seams, testability and AI-navigable architecture",
    "patterns": [
      "\\bmodule design\\b",
      "\\barchitecture\\b",
      "\\binterface seam\\b",
      "\\brefactor\\b"
    ]
  },
  "differential-review": {
    "category": "security",
    "summary": "Security-focused diff, blast radius and git blame regression review",
    "patterns": [
      "\\bdifferential review\\b",
      "\\bdiff review\\b",
      "\\bblast radius\\b",
      "\\bpr security\\b"
    ]
  },
  "doctor": {
    "category": "meta",
    "summary": "Check the installed client profile and language tool availability",
    "patterns": [
      "^/doctor\\b",
      "\\bharness health\\b",
      "\\bdoctor diagnostics\\b"
    ]
  },
  "domain-modeling": {
    "category": "architecture",
    "summary": "Domain glossary (GLOSSARY.md) and architecture decision records (ADRs)",
    "patterns": [
      "\\bdomain[- ]model(?:ing)?\\b",
      "\\b(?:build|create|define|draft|edit|maintain|record|refine|revise|update|write)\\b(?:\\s+[\\w-]+){0,5}\\s+(?:glossary|adrs?|architecture decision records?|domain terminology|ubiquitous language)\\b",
      "\\badd\\b[^.!?\\n]{0,60}\\bto (?:the |our )?glossary\\b"
    ]
  },
  "fair-data-principles": {
    "category": "bioinformatics",
    "summary": "FAIR dataset packaging, metadata dictionaries and scientific provenance",
    "files": [
      "codemeta.json",
      "ro-crate-metadata.json",
      "datapackage.json"
    ],
    "patterns": [
      "\\bfair data\\b",
      "\\bro-crate\\b",
      "\\bmetadata dictionary\\b",
      "\\b(zenodo|figshare|ena|sra)\\b"
    ]
  },
  "first-principles-explainer": {
    "category": "science",
    "summary": "First-principles breakdowns of complex pipelines and discrepancies",
    "patterns": [
      "\\bfirst principles\\b",
      "\\bexplain why\\b",
      "\\bdiscrepancy\\b",
      "\\bfrom scratch intuition\\b"
    ]
  },
  "github-repo-best-practices": {
    "category": "planning",
    "summary": "Top-standard README, citation, community health and release layout",
    "files": [
      "CITATION.cff",
      ".github/PULL_REQUEST_TEMPLATE.md"
    ],
    "patterns": [
      "\\baudit.*repo\\b",
      "\\bwrite.*readme\\b",
      "\\bcitation\\.cff\\b",
      "\\brelease setup\\b"
    ]
  },
  "grill-with-docs": {
    "category": "architecture",
    "summary": "Design interview maintaining glossary and significant ADRs",
    "companions": [
      "grilling",
      "domain-modeling"
    ],
    "invocation_aliases": [
      "sage-grill-with-docs",
      "design interview"
    ]
  },
  "grilling": {
    "category": "architecture",
    "summary": "Interactive design questioning to resolve tradeoffs",
    "patterns": [
      "\\bgrill me\\b",
      "\\bgrilling\\b"
    ]
  },
  "mcp-builder": {
    "category": "tooling",
    "summary": "Design and evaluate FastMCP / TypeScript MCP servers",
    "deps": [
      "fastmcp",
      "@modelcontextprotocol/sdk"
    ],
    "patterns": [
      "\\bmcp server\\b",
      "\\bfastmcp\\b",
      "\\bmodel context protocol\\b",
      "\\bmcp tool\\b"
    ]
  },
  "nextflow": {
    "category": "bioinformatics",
    "summary": "Nextflow DSL2 / nf-core pipelines and HPC/SLURM workflows",
    "files": [
      "*.nf",
      "nextflow.config",
      "nf-test.config",
      "modules.json"
    ],
    "dirs": [
      "subworkflows",
      "conf"
    ],
    "deps": [
      "nextflow"
    ],
    "patterns": [
      "\\bnextflow\\b",
      "\\bnf-core\\b",
      "\\bdsl2\\b",
      "\\bnf-test\\b",
      "\\bslurm\\b"
    ],
    "companions": [
      "fair-data-principles"
    ]
  },
  "overnight-explorer": {
    "category": "research",
    "summary": "Deep unattended multi-branch exploration and reproducible logs",
    "patterns": [
      "\\bovernight\\b",
      "\\bwhile i('m| am)? (away|asleep)\\b",
      "\\bautonomous exploration\\b"
    ]
  },
  "pdf-inplace-editing": {
    "category": "documents",
    "summary": "Zero-drift PDF editing and true anonymization/redaction",
    "patterns": [
      "\\bpdf\\b",
      "\\bredact\\b",
      "\\banonymiz"
    ]
  },
  "pipeline-sketch-results": {
    "category": "science",
    "summary": "Package pipeline outputs into clean numbered deliverables",
    "patterns": [
      "\\bresults/? folder\\b",
      "\\bclient-facing\\b",
      "\\bpublish pipeline results\\b",
      "\\bdeliverable\\b"
    ]
  },
  "pysam": {
    "category": "bioinformatics",
    "summary": "SAM/BAM/CRAM, VCF/BCF, FASTQ, tabix, pileup and coverage workflows",
    "files": [
      "*.bam",
      "*.cram",
      "*.sam",
      "*.vcf",
      "*.vcf.gz",
      "*.bcf",
      "*.fastq",
      "*.fastq.gz",
      "*.fq",
      "*.fq.gz",
      "*.bed"
    ],
    "deps": [
      "pysam",
      "cyvcf2",
      "htslib"
    ],
    "patterns": [
      "\\bpysam\\b",
      "\\bhtslib\\b",
      "\\b(bam|cram|sam|vcf|bcf|fastq|tabix|pileup)\\b",
      "\\bpromethion\\b",
      "\\brev(io)?\\b",
      "\\bepi2me\\b"
    ]
  },
  "read-only": {
    "category": "meta",
    "summary": "Strictly read-only codebase inspection mode",
    "patterns": [
      "^/read-only\\b",
      "\\bread[- ]only mode\\b",
      "\\bno edits\\b"
    ]
  },
  "red-team": {
    "category": "meta",
    "summary": "Check an implementation plan for failure modes and untested assumptions",
    "patterns": [
      "^/(?:sage-)?red-team\\b",
      "\\bstress[- ]test (?:the |this )?plan\\b",
      "\\bred[- ]team (?:the |this )?plan\\b"
    ]
  },
  "review": {
    "category": "quality",
    "summary": "Review a diff for concrete defects and regressions",
    "patterns": [
      "^/sage-review\\b",
      "\\breview (?:the |this )?(?:diff|pull request|changes)\\b"
    ]
  },
  "sage-binary-inspection": {
    "category": "tooling",
    "summary": "Inspect binaries, bytecode, wheels or minified bundles cleanly",
    "patterns": [
      "\\breverse[- ]engineer\\b",
      "\\bdecompil",
      "\\bdisassembl",
      "\\bbytecode\\b",
      "\\bminified bundle\\b"
    ]
  },
  "sage-explain": {
    "category": "science",
    "summary": "First-principles explanations of algorithms and discrepancies",
    "patterns": [
      "\\bfirst principles\\b",
      "\\bexplain why\\b",
      "\\bdiscrepancy\\b"
    ]
  },
  "sage-fair-data": {
    "category": "science",
