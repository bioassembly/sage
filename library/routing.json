{
  "biopython": {
    "category": "bioinformatics",
    "summary": "FASTA/GenBank/PDB parsing, phylogenetics, BLAST and NCBI Entrez",
    "files": [
      "*.fasta",
      "*.fa",
      "*.fna",
      "*.faa",
      "*.gb",
      "*.gbk",
      "*.pdb"
    ],
    "deps": [
      "biopython"
    ],
    "patterns": [
      "\\b(?:biopython|bio\\.(?:seqio|entrez)|fasta|genbank)\\b"
    ],
    "invocation_aliases": [
      "sage-sequence-analysis"
    ]
  },
  "differential-review": {
    "category": "security",
    "summary": "Security-focused diff, blast radius and git blame regression review",
    "patterns": [
      "\\b(?:differential review|pr security review|security impact of (?:the |this )?(?:diff|change|pr))\\b"
    ]
  },
  "doctor": {
    "category": "meta",
    "summary": "Check the installed client profile and language tool availability",
    "patterns": [
      "^/doctor\\b",
      "\\bharness health\\b",
      "\\bdoctor diagnostics\\b"
    ]
  },
  "domain-modeling": {
    "category": "architecture",
    "summary": "Domain glossary (GLOSSARY.md) and architecture decision records (ADRs)",
    "patterns": [
      "\\bdomain[- ]model(?:ing)?\\b",
      "\\b(?:build|create|define|draft|edit|maintain|record|refine|revise|update|write)\\b(?:\\s+[\\w-]+){0,5}\\s+(?:glossary|adrs?|architecture decision records?|domain terminology|ubiquitous language)\\b",
      "\\badd\\b[^.!?\\n]{0,60}\\bto (?:the |our )?glossary\\b"
    ]
  },
  "fair-data-principles": {
    "category": "bioinformatics",
    "summary": "FAIR dataset packaging, metadata dictionaries and scientific provenance",
    "patterns": [
      "\\b(?:fair data|ro-crate|metadata dictionary|dataset provenance)\\b"
    ],
    "invocation_aliases": [
      "sage-fair-data"
    ]
  },
  "grill-with-docs": {
    "category": "architecture",
    "summary": "Design interview maintaining glossary and significant ADRs",
    "companions": [
      "grilling",
      "domain-modeling"
    ],
    "invocation_aliases": [
      "sage-grill-with-docs",
      "design interview"
    ]
  },
  "grilling": {
    "category": "architecture",
    "summary": "Interactive design questioning to resolve tradeoffs",
    "patterns": [
      "^\\s*(?:please\\s+)?grill me\\b",
      "^\\s*[/$]grilling(?=$|\\s)"
    ]
  },
  "mcp-builder": {
    "category": "tooling",
    "summary": "Design and evaluate FastMCP / TypeScript MCP servers",
    "patterns": [
      "\\b(?:build|create|design|implement|develop|author|test)\\b[^\\n.!?]{0,45}\\b(?:mcp server|mcp tool|fastmcp)\\b"
    ],
    "invocation_aliases": [
      "sage-mcp-builder"
    ]
  },
  "nextflow": {
    "category": "bioinformatics",
    "summary": "Nextflow DSL2 / nf-core pipelines and HPC/SLURM workflows",
    "files": [
      "*.nf",
      "nextflow.config",
      "nf-test.config"
    ],
    "deps": [
      "nextflow"
    ],
    "patterns": [
      "\\b(nextflow|nf-core|dsl2|nf-test)\\b"
    ]
  },
  "pysam": {
    "category": "bioinformatics",
    "summary": "SAM/BAM/CRAM, VCF/BCF, FASTQ, tabix, pileup and coverage workflows",
    "deps": [
      "pysam",
      "cyvcf2",
      "htslib"
    ],
    "patterns": [
      "\\bpysam\\b",
      "\\bhtslib\\b",
      "\\b(bam|cram|vcf|bcf|tabix|pileup)\\b"
    ],
    "files": [
      "*.bam",
      "*.cram",
      "*.vcf",
      "*.vcf.gz",
      "*.bcf"
    ]
  },
  "read-only": {
    "category": "meta",
    "summary": "Strictly read-only codebase inspection mode",
    "patterns": [
      "^/read-only\\b",
      "\\bread[- ]only mode\\b",
      "\\bno edits\\b"
    ]
  },
  "red-team": {
    "category": "meta",
    "summary": "Check an implementation plan for failure modes and untested assumptions",
    "patterns": [
      "^\\s*/(?:sage-)?red-team(?=$|\\s)",
      "\\b(?:stress[- ]test|red[- ]team) (?:the |this |my |our |a )?(?:implementation |migration |deployment )?plan\\b"
    ]
  },
  "sage-binary-inspection": {
    "category": "tooling",
    "summary": "Inspect binaries, bytecode, wheels or minified bundles cleanly",
    "patterns": [
      "\\b(?:inspect|analy[sz]e|identify)\\b[^\\n.!?]{0,55}\\b(?:binary|executable|opaque artifact|minified bundle|bytecode)\\b"
    ]
  },
  "sage-debug": {
    "category": "engineering",
    "summary": "Reproduce a defect and verify its root cause",
    "patterns": [
      "\\b(?:debug|diagnose|triage|reproduce|fix)\\b[^\\n.!?]{0,65}\\b(?:bug|crash|regression|race condition|flaky tests?|failing tests?|test failures?|hang|deadlock)\\b",
      "\\broot cause\\b[^\\n.!?]{0,42}\\b(?:crash|failure|error|bug|tests?)\\b",
      "\\b(?:trace|diagnose)\\b[^\\n.!?]{0,55}\\b(?:failure|regression)\\b[^\\n.!?]{0,25}\\bacross (?:services|components|processes)\\b"
    ],
    "invocation_aliases": [
      "systematic-debugging"
    ]
  },
  "sage-design": {
    "category": "architecture",
    "summary": "Design or refactor a module interface and test the trade-offs",
    "patterns": [
      "\\b(?:module design|interface seams?)\\b",
      "\\b(?:design|refactor|redesign|simplify)\\b[^\\n.!?]{0,48}\\b(?:module boundaries|module interface|subsystem|subsystems|interfaces|architecture|interfaces between)\\b",
      "\\b(?:deepen (?:the |these )?modules?|deep module design)\\b"
    ],
    "invocation_aliases": [
      "codebase-design"
    ]
  },
  "sage-explain": {
    "category": "science",
    "summary": "First-principles explanations of algorithms and discrepancies",
    "patterns": [
      "\\b(?:from first principles|first[- ]principles explanation)\\b"
    ],
    "invocation_aliases": [
      "first-principles-explainer"
    ]
  },
  "sage-genomics": {
    "category": "bioinformatics",
    "summary": "Nextflow/nf-core, BAM/CRAM/VCF/FASTQ and QC genomics workflows",
    "patterns": [
      "\\b(?:sequencing|read alignment|resequencing) (?:qc|quality control)\\b",
      "\\bsequencing (?:analysis pipeline|qc report)\\b"
    ]
  },
  "sage-git-commit": {
    "category": "engineering",
    "summary": "Prepare an authorized commit or push using repository conventions",
    "patterns": [
      "^\\s*(?:please\\s+)?(?:git\\s+)?(?:commit|push|stage)\\b[^\\n.!?]{0,50}\\b(?:changes|repo|branch|to origin|to github|this|everything)\\b",
      "^\\s*(?:please\\s+)?(?:git\\s+)?commit\\s+and\\s+push\\b",
      "^\\s*(?:please\\s+)?write a commit message\\b"
    ],
    "invocation_aliases": [
      "git-commit-convention"
    ]
  },
  "sage-git-worktrees": {
    "category": "git",
    "summary": "Isolated git worktrees for parallel work",
    "patterns": [
      "\\bworktree\\b",
      "\\bisolated branch\\b"
    ],
    "invocation_aliases": [
      "using-git-worktrees"
    ]
  },
  "sage-harness-eval": {
    "category": "meta",
    "summary": "Evaluate harness and prompt changes with assertions",
    "patterns": [
      "\\b(?:evaluate|benchmark)\\b[^\\n.!?]{0,55}\\b(?:skill|harness|router|routing)\\b",
      "\\b(?:harness eval|routing benchmark|skill evaluation)\\b"
    ],
    "invocation_aliases": [
      "skill-evaluation"
    ]
  },
  "sage-overnight": {
    "category": "research",
    "summary": "Unattended deep exploration with verified findings logs",
    "patterns": [
      "\\bovernight\\b",
      "\\bwhile i('m| am)? (away|asleep)\\b",
      "\\bautonomous exploration\\b"
    ],
    "invocation_aliases": [
      "overnight-explorer"
    ]
  },
  "sage-pdf-editing": {
    "category": "documents",
    "summary": "In-place PDF editing and true anonymization/redaction",
    "patterns": [
      "\\b(?:edit|redact|anonymi[sz]e|modify|replace text in)\\b[^\\n.!?]{0,55}\\bpdf\\b"
    ],
    "invocation_aliases": [
      "pdf-inplace-editing"
    ]
  },
  "sage-repo-maintenance": {
    "category": "engineering",
    "summary": "Improve CI, release hygiene and contributor documentation",
    "patterns": [
      "\\b(?:audit|improve|update|fix|set up)\\b[^\\n.!?]{0,48}\\b(?:repo hygiene|ci workflow|release automation|contributor documentation|contributing guide)\\b"
    ],
    "invocation_aliases": [
      "github-repo-best-practices"
    ]
  },
  "sage-results-package": {
    "category": "science",
    "summary": "Package pipeline outputs into clean client deliverables",
    "patterns": [
      "\\b(?:assemble|package|prepare|publish|deliver)\\b[^\\n.!?]{0,55}\\b(?:results package|pipeline results|results folder|research deliverables)\\b"
    ],
    "invocation_aliases": [
      "pipeline-sketch-results"
    ]
  },
  "sage-review": {
    "category": "engineering",
    "summary": "Find actionable defects and regressions in a code change",
    "patterns": [
      "^\\s*/(?:sage-)?review(?=$|\\s)",
      "\\bapply\\s+the\\s+`sage-review`\\s+skill\\b",
      "\\b(?:review|inspect) (?:the |this |my |our |a )?(?:working diff|diff|pull request|code changes|changes|pr)\\b"
    ],
    "invocation_aliases": [
      "review"
    ]
  },
  "sage-scientific-report": {
    "category": "science",
    "summary": "Statistical figures, Quarto/scientific report QC and bias checks",
    "patterns": [
      "\\b(?:write|draft|compile|generate|edit|render|prepare)\\b[^\\n.!?]{0,55}\\b(?:scientific report|quarto report|r markdown report)\\b"
    ],
    "companions": [
      "fair-data-principles"
    ]
  },
  "sage-security-audit": {
    "category": "security",
    "summary": "Web/API security audit for auth, injection, XSS, CSRF and SSRF",
    "patterns": [
      "\\bsecurity (?:audit|assessment|hardening)\\b"
    ],
    "invocation_aliases": [
      "security-audit"
    ]
  },
  "sage-spec": {
    "category": "planning",
    "summary": "Requirements and functional specifications",
    "patterns": [
      "\\b(?:write|draft|define|create)\\b[^\\n.!?]{0,45}\\b(?:specification|functional spec|prd|a spec)\\b"
    ]
  },
  "sage-test-design": {
    "category": "engineering",
    "summary": "Choose behavior-focused tests and regression checks",
    "patterns": [
      "\\btest (?:design|plan|coverage|strategy)\\b",
      "\\b(?:choose|design|plan|add|write)\\b[^\\n.!?]{0,45}\\b(?:regression tests?|test cases|behavioral tests?)\\b"
    ]
  },
  "sage-tickets": {
    "category": "planning",
    "summary": "Vertical-slice task and issue breakdown",
    "patterns": [
      "\\b(?:draft|create|split|break down|break)\\b[^\\n.!?]{0,60}\\b(?:tickets|work items|implementation issues)\\b"
    ]
  },
  "sage-web-scraping": {
    "category": "web",
    "summary": "Structured extraction from web pages and APIs",
    "patterns": [
      "\\bweb scrap(?:e|er|ing)\\b",
      "\\b(?:scrape|crawl|extract)\\b[^\\n.!?]{0,45}\\b(?:from a website|from the website|from a web page|from the web page|web pages|website|html pages|an html table)\\b"
    ],
    "invocation_aliases": [
      "web-scraping"
    ]
  },
  "sage-webapp-testing": {
    "category": "web",
    "summary": "Local browser UI verification and Playwright debugging",
    "patterns": [
      "\\b(?:playwright|cypress|browser|e2e|end.to.end) (?:tests?|testing|suite|verification)\\b",
      "\\btest\\b[^\\n.!?]{0,55}\\b(?:in a browser|in the browser|web app|web application)\\b"
    ],
    "invocation_aliases": [
      "webapp-testing"
    ]
  },
  "setup-matt-pocock-skills": {
    "category": "planning",
    "summary": "Initialize project workflow labels/conventions for spec-to-issue flow"
  },
  "skill-acquisition": {
    "category": "meta",
    "summary": "Find and vet a reusable skill for a gap in the active library",
    "patterns": [
      "\\b(?:find|vet|install|acquire|search for)\\b[^\\n.!?]{0,45}\\b(?:reusable skill|agent skill|a skill for)\\b"
    ]
  },
  "skill-maker": {
    "category": "meta",
    "summary": "Author or refine skills with focused triggers and validation",
    "patterns": [
      "\\b(author|create|write|improve) a? ?skill\\b",
      "\\bskill[- ]maker\\b"
    ]
  },
  "statistical-data-visualization": {
    "category": "science",
    "summary": "Statistical plot correctness, bias checks and bioinformatics figures",
    "patterns": [
      "\\b(?:draw|plot|visualize|visualise|generate|create|make|design)\\b[^\\n.!?]{0,55}\\b(?:scatter plot|pca plot|umap plot|violin plot|boxplot|heatmap|volcano plot|statistical plots?|visuali[sz]ation of the data)\\b"
    ]
  },
  "test-driven-development": {
    "category": "engineering",
    "summary": "Implement a requested change through a failing test and a passing fix",
    "patterns": [
      "\\b(?:test[- ]driven development|test[- ]first|red[- ]green[- ]refactor|use tdd)\\b"
    ]
  },
  "to-spec": {
    "category": "planning",
    "summary": "Flesh out specifications/PRDs from rough feature ideas"
  },
  "to-tickets": {
    "category": "planning",
    "summary": "Break specs/PRDs into vertical-slice implementation issues"
  },
  "token-efficiency": {
    "category": "meta",
    "summary": "Diagnose context bloat and reduce harness token overhead",
    "patterns": [
      "\\btoken (?:efficiency|overhead|usage|savings)\\b",
      "\\b(?:burning|save|saving) (?:too many |more )?tokens\\b",
      "\\bcontext bloat\\b",
      "\\b(?:reduce|cut|trim)\\b[^\\n.!?]{0,48}\\b(?:tool output|context size|context overhead)\\b"
    ]
  },
  "variant-analysis": {
    "category": "security",
    "summary": "Find sibling bug variants across a codebase via patterns/CodeQL/Semgrep",
    "patterns": [
      "\\bvariant analysis\\b",
      "\\b(?:find|search for|check for)\\b[^\\n.!?]{0,55}\\b(?:other instances|same bug|similar defects)\\b"
    ]
  },
  "vercel-react-best-practices": {
    "category": "web",
    "summary": "React and Next.js performance, server/client boundaries and bundling",
    "files": [
      "next.config.*"
    ],
    "deps": [
      "react",
      "next"
    ],
    "patterns": [
      "\\breact\\b",
      "\\bnext\\.?js\\b",
      "\\bhydration\\b",
      "\\bserver component\\b",
      "\\buseeffect\\b"
    ]
  },
  "verification-before-completion": {
    "category": "engineering",
    "summary": "Run fresh checks before making a completion claim",
    "patterns": [
      "\\b(?:verify|confirm|prove)\\b[^\\n.!?]{0,40}\\b(?:the fix works|the tests pass|ready to (?:ship|merge)|before (?:finishing|merging|shipping))\\b"
    ]
  },
  "workflow-graph": {
    "category": "architecture",
    "summary": "Trace repository workflows into editable Graphviz diagrams and offline SVG previews",
    "patterns": [
      "\\bgraphviz\\b",
      "\\b(workflow|architecture|pipeline|control.flow|data.flow)\\s+(graph|diagram)s?\\b",
      "\\b(map|diagram|visuali[sz]e)\\b.{0,45}\\b(workflow|architecture|control flow|data flow)\\b"
    ]
  }
}
